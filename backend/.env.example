CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=^https://processamento-de-linguagem-natural(?:-[a-z0-9]+)?\.vercel\.app$

# Configure estes valores no Render ou em um arquivo local backend/.env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Nunca exponha esta chave no frontend ou no repositório.
CONNECTOR_ENCRYPTION_KEY=

# Google Drive OAuth. O redirect deve apontar para a rota /upload da Vercel.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/upload

# Slack OAuth. Configure a Redirect URL no aplicativo Slack com o mesmo valor.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/upload

# Microsoft Graph OAuth para Teams e SharePoint. Em producao, use o ID do tenant corporativo.
MICROSOFT_TENANT_ID=organizations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/upload
