# URL pública da interface que será homologada. Pode ser a Vercel ou um ambiente local.
E2E_BASE_URL=https://SEU-FRONTEND.vercel.app

# URL pública da API FastAPI, usada apenas na checagem de acesso não autorizado.
E2E_API_URL=https://SUA-API.onrender.com

# Projeto Supabase de HOMOLOGAÇÃO. Não use a chave de serviço de um projeto de produção.
# As contas QA são criadas e removidas automaticamente em cada execução.
E2E_SUPABASE_URL=https://SEU-PROJETO.supabase.co
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Protege contra uma execução externa acidental. Use true somente no ambiente de homologação.
ALLOW_EXTERNAL_E2E=false

# O teste chama o Copiloto real. Use false para executar somente a homologação documental.
E2E_RUN_COPILOT=true

# Domínio reservado para as contas descartáveis criadas pela suíte.
E2E_QA_EMAIL_DOMAIN=synapse-e2e.invalid
